# Lives only on the control-plane host (/etc/dealwatch.env). Never passed to the sandbox.
VULTR_INFERENCE_API_KEY=your-vultr-serverless-inference-key
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
DEALWATCH_MODEL=qwen3.8-flash-next
DEALWATCH_VISION_MODEL=qwen3.8-flash-next
SANDBOX_RUNTIME=runsc
SANDBOX_NETWORK=dwsandbox
SANDBOX_MEMORY=900m
SANDBOX_TIMEOUT=90
WATCH_INTERVAL_HOURS=12
PUBLIC_RUNS_PER_HOUR=40
